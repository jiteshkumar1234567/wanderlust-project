<% layout("/layouts/boilerplate") %>
<section class="page-hero"><div class="site-shell"><span class="eyebrow">Host reservations</span><h1>Welcome every arrival.</h1><p>See real guest reservations across only the properties owned by your account.</p></div></section>
<section class="section"><div class="site-shell"><div class="dashboard-title"><div><h2>Guest itinerary</h2><p><%= bookings.length %> total <%= bookings.length === 1 ? 'reservation' : 'reservations' %></p></div><a href="/listings/mine" class="button button-ghost">Manage listings</a></div>
  <% if (bookings.length) { %><div class="reservation-table-wrap"><table class="reservation-table"><thead><tr><th>Guest</th><th>Property</th><th>Stay</th><th>Travelers</th><th>Value</th><th>Status</th><th><span class="visually-hidden">Action</span></th></tr></thead><tbody><% bookings.forEach(booking => { %><tr><td><div class="table-guest"><span class="profile-avatar"><%= booking.user?.username?.charAt(0).toUpperCase() %></span><span><strong><%= booking.user?.username %></strong><small><%= booking.user?.email %></small></span></div></td><td><strong><%= booking.listing?.title || 'Unavailable' %></strong><small><%= booking.listing?.location %></small></td><td><strong><%= booking.checkIn.toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %> → <%= booking.checkOut.toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></strong><small><%= booking.numberOfNights %> nights</small></td><td><%= booking.guests %></td><td><strong>₹<%= booking.totalAmount.toLocaleString('en-IN') %></strong><small class="status-text-<%= booking.paymentStatus %>"><%= booking.paymentStatus %></small></td><td><span class="status-badge status-<%= booking.bookingStatus %>"><%= booking.bookingStatus %></span></td><td><a href="/bookings/<%= booking._id %>" class="icon-button" aria-label="View booking"><i class="fa-solid fa-arrow-right"></i></a></td></tr><% }) %></tbody></table></div><% } else { %><%- include("../includes/emptyState", { heading: "No guest arrivals yet", message: "When travelers reserve one of your properties, their itinerary will appear here.", href: "/listings/mine", cta: "View your listings", icon: "fa-calendar-day" }) %><% } %>
</div></section>
