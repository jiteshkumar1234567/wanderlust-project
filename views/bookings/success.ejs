<% layout("/layouts/boilerplate") %>
<section class="success-page"><div class="success-orbit"><span><i class="fa-solid fa-check"></i></span></div><span class="eyebrow">Payment verified</span><h1>Your journey is confirmed.</h1><p>A new place is officially on your horizon. Your itinerary is ready below.</p>
  <article class="success-ticket"><% if (booking.listing?.image?.url) { %><img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>"><% } %><div class="success-ticket-main"><span><i class="fa-solid fa-location-dot"></i> <%= booking.listing?.location %>, <%= booking.listing?.country %></span><h2><%= booking.listing?.title %></h2><div><p><small>Check in</small><strong><%= booking.checkIn.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></strong></p><p><small>Check out</small><strong><%= booking.checkOut.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></strong></p><p><small>Travelers</small><strong><%= booking.guests %></strong></p></div></div><div class="success-ticket-side"><span class="status-badge status-paid"><i class="fa-solid fa-circle-check"></i> Paid</span><small>Amount paid</small><strong>₹<%= booking.totalAmount.toLocaleString('en-IN') %></strong><small>Booking reference</small><code><%= booking._id %></code><small>Payment ID</small><code><%= booking.razorpayPaymentId %></code></div></article>
  <div class="success-actions"><a href="/bookings/<%= booking._id %>" class="button button-primary">View booking</a><a href="/listings" class="button button-ghost">Explore more stays</a></div>
</section>
