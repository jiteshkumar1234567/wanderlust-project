<% layout("/layouts/boilerplate") %>
<section class="page-hero compact-hero"><div class="site-shell"><a href="<%= booking.user._id.equals(currUser._id) ? '/bookings' : '/host/bookings' %>" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to bookings</a><span class="eyebrow">Booking details</span><h1>Your stay itinerary.</h1></div></section>
<section class="section booking-detail-page"><div class="site-shell booking-detail-layout">
  <article class="booking-document"><div class="document-head"><div><span>Booking reference</span><strong><%= booking._id %></strong></div><span class="status-badge status-<%= booking.bookingStatus %>"><%= booking.bookingStatus %></span></div>
    <% if (booking.listing?.image?.url) { %><img class="document-image" src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>"><% } %><div class="document-body"><span class="itinerary-location"><i class="fa-solid fa-location-dot"></i> <%= booking.listing?.location %>, <%= booking.listing?.country %></span><h2><%= booking.listing?.title || 'Listing unavailable' %></h2>
      <div class="detail-date-grid"><div><small>Check in</small><strong><%= booking.checkIn.toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'long',year:'numeric'}) %></strong></div><div><small>Check out</small><strong><%= booking.checkOut.toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'long',year:'numeric'}) %></strong></div><div><small>Length</small><strong><%= booking.numberOfNights %> nights</strong></div><div><small>Travelers</small><strong><%= booking.guests %> guests</strong></div></div>
      <div class="guest-line"><span class="profile-avatar"><%= booking.user.username.charAt(0).toUpperCase() %></span><div><small>Booked for</small><strong><%= booking.user.username %></strong><span><%= booking.user.email %></span></div></div>
    </div>
  </article>
  <aside class="payment-summary"><h2>Payment summary</h2><div><span>₹<%= booking.pricePerNight.toLocaleString('en-IN') %> × <%= booking.numberOfNights %> nights</span><strong>₹<%= booking.subtotal.toLocaleString('en-IN') %></strong></div><div><span>Service fee</span><strong>₹<%= booking.platformFee.toLocaleString('en-IN') %></strong></div><hr><div class="summary-total"><span>Total</span><strong>₹<%= booking.totalAmount.toLocaleString('en-IN') %></strong></div><div class="payment-state"><span class="status-badge status-<%= booking.paymentStatus %>"><%= booking.paymentStatus %></span><% if (booking.razorpayPaymentId) { %><small>Payment ID<br><%= booking.razorpayPaymentId %></small><% } %></div><div class="secure-note"><i class="fa-solid fa-shield-halved"></i><span><strong>Payment verification</strong>Processed securely through Razorpay.</span></div><% if (booking.listing) { %><a href="/listings/<%= booking.listing._id %>" class="button button-ghost w-100">View property</a><% } %></aside>
</div></section>
