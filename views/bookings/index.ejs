<% layout("/layouts/boilerplate") %>
<section class="page-hero booking-page-hero"><div class="site-shell"><span class="eyebrow">Your journeys</span><h1>Trips, beautifully organized.</h1><p>Every confirmed escape, past adventure and cancelled plan in one clear itinerary.</p></div></section>
<section class="section bookings-dashboard"><div class="site-shell">
  <div class="booking-tabs" role="tablist" aria-label="Filter bookings"><button class="active" type="button" data-booking-tab="upcoming">Upcoming <span><%= bookings.filter(item => !['cancelled','completed'].includes(item.bookingStatus) && item.checkOut >= new Date()).length %></span></button><button type="button" data-booking-tab="completed">Completed <span><%= bookings.filter(item => item.bookingStatus === 'completed' || (item.bookingStatus === 'confirmed' && item.checkOut < new Date())).length %></span></button><button type="button" data-booking-tab="cancelled">Cancelled <span><%= bookings.filter(item => item.bookingStatus === 'cancelled').length %></span></button><button type="button" data-booking-tab="all">All <span><%= bookings.length %></span></button></div>
  <% if (bookings.length) { %><div class="itinerary-list"><% bookings.forEach(booking => { const tabStatus = booking.bookingStatus === 'cancelled' ? 'cancelled' : (booking.bookingStatus === 'completed' || (booking.bookingStatus === 'confirmed' && booking.checkOut < new Date())) ? 'completed' : 'upcoming'; %><article class="itinerary-card" data-booking-card data-tab-status="<%= tabStatus %>">
    <div class="itinerary-image"><% if (booking.listing?.image?.url) { %><img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>"><% } else { %><span><i class="fa-regular fa-image"></i></span><% } %><span class="status-badge status-<%= booking.bookingStatus %>"><%= booking.bookingStatus %></span></div>
    <div class="itinerary-content"><div class="itinerary-top"><div><span class="itinerary-location"><i class="fa-solid fa-location-dot"></i> <%= booking.listing?.location || 'Listing unavailable' %></span><h2><%= booking.listing?.title || 'Listing unavailable' %></h2></div><span class="status-badge status-<%= booking.paymentStatus %>"><i class="fa-solid fa-circle"></i> <%= booking.paymentStatus %></span></div>
      <div class="trip-timeline"><div><small>Check in</small><strong><%= booking.checkIn.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></strong></div><i class="fa-solid fa-arrow-right-long"></i><div><small>Check out</small><strong><%= booking.checkOut.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></strong></div><div><small>Guests</small><strong><%= booking.guests %></strong></div><div><small>Total</small><strong>₹<%= booking.totalAmount.toLocaleString('en-IN') %></strong></div></div>
      <div class="itinerary-actions"><a href="/bookings/<%= booking._id %>" class="button button-dark button-small">View itinerary</a><% if (booking.listing) { %><a href="/listings/<%= booking.listing._id %>" class="button button-ghost button-small">Property</a><% } %><% if (!["cancelled","completed"].includes(booking.bookingStatus) && booking.checkIn > new Date()) { %><form action="/bookings/<%= booking._id %>/cancel" method="POST" data-cancel-form><button class="cancel-link" type="submit">Cancel booking</button></form><% } %></div>
    </div>
  </article><% }) %></div><div class="empty-state d-none" data-filter-empty><span class="empty-icon"><i class="fa-regular fa-calendar"></i></span><h3>No trips in this view</h3><p>Your other journeys are available in the tabs above.</p></div><% } else { %><%- include("../includes/emptyState", { heading: "Your first journey is waiting", message: "Explore thoughtfully hosted properties and build an itinerary worth looking forward to.", href: "/listings", cta: "Explore stays", icon: "fa-suitcase-rolling" }) %><% } %>
</div></section>
