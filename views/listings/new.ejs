<% layout("/layouts/boilerplate") %>
<section class="host-form-page"><div class="site-shell narrow-shell"><div class="form-page-head"><a href="/listings/mine" class="back-link"><i class="fa-solid fa-arrow-left"></i> Host dashboard</a><span class="eyebrow">Create a stay</span><h1>Share a place worth discovering.</h1><p>Give travelers the details they need to understand, trust and choose your property.</p></div>
  <form method="POST" action="/listings" class="host-listing-form needs-validation" enctype="multipart/form-data" novalidate>
    <section class="form-section"><div class="form-section-title"><span>01</span><div><h2>Property story</h2><p>Lead with a clear title and an honest, compelling description.</p></div></div><div class="form-section-fields"><label class="form-label" for="title">Listing title</label><input id="title" name="listing[title]" class="form-control" placeholder="e.g. Quiet hillside home overlooking the valley" required><div class="invalid-feedback">Add a listing title.</div><label class="form-label mt-3" for="description">Description</label><textarea id="description" name="listing[description]" class="form-control" rows="6" placeholder="Describe the atmosphere, space and what makes it memorable…" required></textarea><div class="invalid-feedback">Describe your property.</div></div></section>
    <section class="form-section"><div class="form-section-title"><span>02</span><div><h2>Place and category</h2><p>Help guests understand where it is and what kind of stay to expect.</p></div></div><div class="form-section-fields"><div class="form-grid"><div><label class="form-label" for="location">City or location</label><input id="location" name="listing[location]" class="form-control" placeholder="Jaipur, Rajasthan" required><div class="invalid-feedback">Add a location.</div></div><div><label class="form-label" for="country">Country</label><input id="country" name="listing[country]" class="form-control" placeholder="India" required><div class="invalid-feedback">Add a country.</div></div></div><label class="form-label mt-3" for="category">Collection</label><select id="category" name="listing[category]" class="form-select" required><option value="">Choose the best fit</option><option>Trending</option><option>Rooms</option><option>Cities</option><option>Mountain</option><option>Castles</option><option>Pools</option><option>Lakes</option><option>Beach</option><option>Camping</option><option>Domes</option><option value="Arictic">Arctic</option><option>Boats</option></select><div class="invalid-feedback">Choose a collection.</div></div></section>
    <section class="form-section"><div class="form-section-title"><span>03</span><div><h2>Price and photography</h2><p>Set a nightly price and add one strong landscape image.</p></div></div><div class="form-section-fields"><label class="form-label" for="price">Nightly price (INR)</label><div class="money-input"><span>₹</span><input id="price" name="listing[price]" type="number" class="form-control" min="1" placeholder="4500" required></div><div class="invalid-feedback">Set a valid nightly price.</div><label class="upload-zone mt-4" for="image"><i class="fa-regular fa-image"></i><strong>Choose property image</strong><span>JPG, PNG or WEBP · landscape images work best</span><input id="image" name="listing[image]" type="file" accept="image/*" data-image-input required></label><div class="image-preview" data-image-preview hidden><img alt="Selected property preview"><button type="button" data-clear-image>Choose another</button></div></div></section>
    <div class="form-submit-bar"><div><i class="fa-solid fa-shield-halved"></i><span><strong>Review before publishing</strong>Your listing becomes visible immediately after creation.</span></div><button class="button button-primary" type="submit">Publish listing <i class="fa-solid fa-arrow-right"></i></button></div>
  </form>
</div></section>
