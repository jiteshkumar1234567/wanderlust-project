<% layout("/layouts/boilerplate") %>
<% const isHost = currUser && currUser._id.equals(listing.owner._id); const reviewCount = listing.reviews.length; const avgRating = reviewCount ? listing.reviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) / reviewCount : null; %>

<section class="detail-head"><div class="site-shell">
  <div class="detail-title-row"><div><span class="eyebrow"><%= listing.category === 'Arictic' ? 'Arctic' : listing.category %> stay</span><h1><%= listing.title %></h1><div class="detail-subline"><span><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></span><span><i class="fa-solid fa-star"></i> <%= avgRating ? avgRating.toFixed(1) : 'New' %> · <a href="#reviews"><%= reviewCount %> <%= reviewCount === 1 ? 'review' : 'reviews' %></a></span></div></div><div class="detail-actions"><button class="button button-ghost button-small" type="button" data-share-page><i class="fa-solid fa-arrow-up-from-bracket"></i> Share</button><% if (isHost) { %><a class="button button-dark button-small" href="/listings/<%= listing._id %>/edit"><i class="fa-solid fa-pen"></i> Edit stay</a><% } %></div></div>
  <div class="property-gallery"><img src="<%= listing.image?.url %>" alt="<%= listing.title %> in <%= listing.location %>"><div class="gallery-caption"><span><i class="fa-regular fa-image"></i> Property photography</span></div></div>
</div></section>

<section class="detail-main"><div class="site-shell detail-layout">
  <div class="detail-content">
    <div class="host-intro"><div><span class="profile-avatar host-avatar"><%= listing.owner.username.charAt(0).toUpperCase() %></span><div><h2>Hosted by <%= listing.owner.username %></h2><p>Independent host on Wanderlust</p></div></div><span class="verified-host"><i class="fa-solid fa-shield-check"></i> Authenticated host</span></div>
    <div class="property-facts"><div><i class="fa-solid fa-house"></i><span><strong>Distinctive stay</strong><small>Entire listing as presented by the host</small></span></div><div><i class="fa-solid fa-location-crosshairs"></i><span><strong><%= listing.location %></strong><small><%= listing.country %></small></span></div><div><i class="fa-solid fa-tag"></i><span><strong><%= listing.category === 'Arictic' ? 'Arctic' : listing.category %></strong><small>Property collection</small></span></div></div>
    <div class="content-block"><span class="eyebrow">About the stay</span><h2>A closer look</h2><p class="property-description"><%= listing.description %></p></div>
    <div class="content-block"><span class="eyebrow">Location</span><h2>Explore the surroundings</h2><p><i class="fa-solid fa-location-dot text-accent"></i> <%= listing.location %>, <%= listing.country %></p><div class="map-frame"><iframe title="Map showing <%= listing.location %>" width="100%" height="360" frameborder="0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=<%= encodeURIComponent(listing.location + ',' + listing.country) %>&z=14&output=embed"></iframe></div></div>

    <div class="content-block reviews-block" id="reviews"><div class="review-heading"><div><span class="eyebrow">Guest notes</span><h2><%= avgRating ? avgRating.toFixed(1) : 'New' %> <i class="fa-solid fa-star"></i> · <%= reviewCount %> <%= reviewCount === 1 ? 'review' : 'reviews' %></h2></div></div>
      <% if (reviewCount) { %><div class="review-grid"><% listing.reviews.forEach(review => { %><article class="review-item"><div class="review-author"><span class="review-avatar"><%= review.author.username.charAt(0).toUpperCase() %></span><div><strong><%= review.author.username %></strong><small><%= review.createdAt ? review.createdAt.toLocaleDateString('en-IN',{month:'short',year:'numeric'}) : 'Guest review' %></small></div><span class="review-stars"><i class="fa-solid fa-star"></i> <%= review.rating %></span></div><p><%= review.comment %></p><% if (currUser && currUser._id.equals(review.author._id)) { %><form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" onsubmit="return confirm('Delete this review?');"><button class="review-delete" type="submit">Delete review</button></form><% } %></article><% }) %></div><% } else { %><%- include("../includes/emptyState", { heading: "No guest notes yet", message: "Be the first guest to share an honest perspective on this stay.", href: null, cta: "", icon: "fa-comment-dots" }) %><% } %>
      <% if (currUser) { %><form action="/listings/<%= listing._id %>/reviews" method="POST" class="review-form needs-validation" novalidate><div><h3>Share your experience</h3><p>Your review helps future travelers make a more confident choice.</p></div><fieldset class="starability-slot"><legend class="visually-hidden">Rate this listing</legend><input type="radio" id="rate1" name="review[rating]" value="1" required><label for="rate1">1 star</label><input type="radio" id="rate2" name="review[rating]" value="2"><label for="rate2">2 stars</label><input type="radio" id="rate3" name="review[rating]" value="3"><label for="rate3">3 stars</label><input type="radio" id="rate4" name="review[rating]" value="4"><label for="rate4">4 stars</label><input type="radio" id="rate5" name="review[rating]" value="5"><label for="rate5">5 stars</label></fieldset><label class="form-label" for="review-comment">Your review</label><textarea id="review-comment" name="review[comment]" class="form-control" placeholder="What stood out about your stay?" required></textarea><div class="invalid-feedback">Please add a rating and review.</div><button class="button button-dark" type="submit">Publish review</button></form><% } else { %><div class="review-signin"><span>Stayed here before?</span><a href="/login" class="text-link">Log in to write a review</a></div><% } %>
    </div>
    <% if (isHost) { %><div class="host-danger-zone"><div><strong>Manage this listing</strong><p>Edit property information or permanently remove it.</p></div><div><a href="/listings/<%= listing._id %>/edit" class="button button-ghost button-small">Edit</a><form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Permanently delete this listing?');"><button class="button danger-button button-small">Delete</button></form></div></div><% } %>
  </div>

  <aside class="booking-column"><div id="booking-card" class="booking-panel" data-listing-id="<%= listing._id %>" data-price="<%= listing.price %>" data-fee-percent="<%= platformFeePercent %>" data-logged-in="<%= Boolean(currUser) %>" data-is-host="<%= Boolean(isHost) %>">
    <div class="booking-panel-head"><div><strong>₹<%= Number(listing.price).toLocaleString('en-IN') %></strong><span> / night</span></div><span><i class="fa-solid fa-star"></i> <%= avgRating ? avgRating.toFixed(1) : 'New' %></span></div>
    <div id="booking-alert" class="booking-alert d-none" role="alert"></div>
    <div class="booking-fields"><label><span>Check in</span><input id="check-in" type="date" required></label><label><span>Check out</span><input id="check-out" type="date" required></label><label class="guest-field"><span>Guests</span><input id="guests" type="number" value="1" min="1" step="1" required></label></div>
    <div id="price-breakdown" class="price-breakdown d-none"><div><span>₹<%= Number(listing.price).toLocaleString('en-IN') %> × <span id="night-count">0</span> nights</span><span id="booking-subtotal"></span></div><div><span>Service fee (<%= platformFeePercent %>%)</span><span id="booking-fee"></span></div><hr><div class="booking-total"><span>Total payable</span><span id="booking-total"></span></div></div>
    <% if (isHost) { %><button class="button button-ghost w-100" disabled>Your listing</button><% } else if (!currUser) { %><a href="/login" class="button button-primary w-100">Log in to reserve</a><% } else { %><button id="book-now" class="button button-primary w-100">Continue to secure payment</button><% } %>
    <div class="secure-note"><i class="fa-solid fa-lock"></i><span><strong>Secure Razorpay checkout</strong>Your booking confirms only after verified payment.</span></div>
  </div></aside>
</div></section>

<script id="booked-dates-data" type="application/json"><%- JSON.stringify(bookedDates).replace(/</g, '\\u003c') %></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/booking.js"></script>
