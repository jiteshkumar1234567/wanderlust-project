<% layout("/layouts/boilerplate") %>
<section class="host-form-page"><div class="site-shell narrow-shell"><div class="form-page-head"><a href="/listings/<%= listing._id %>" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to listing</a><span class="eyebrow">Edit your stay</span><h1>Keep the details current.</h1><p>Accurate descriptions, pricing and imagery help guests book with confidence.</p></div>
  <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="host-listing-form needs-validation" enctype="multipart/form-data" novalidate>
    <section class="form-section"><div class="form-section-title"><span>01</span><div><h2>Property story</h2><p>Refine how guests first understand your place.</p></div></div><div class="form-section-fields"><label class="form-label" for="title">Listing title</label><input id="title" name="listing[title]" class="form-control" value="<%= listing.title %>" required><div class="invalid-feedback">Add a listing title.</div><label class="form-label mt-3" for="description">Description</label><textarea id="description" name="listing[description]" class="form-control" rows="6" required><%= listing.description %></textarea><div class="invalid-feedback">Describe your property.</div></div></section>
    <section class="form-section"><div class="form-section-title"><span>02</span><div><h2>Location and collection</h2><p>Keep discovery information accurate.</p></div></div><div class="form-section-fields"><div class="form-grid"><div><label class="form-label" for="location">City or location</label><input id="location" name="listing[location]" value="<%= listing.location %>" class="form-control" required></div><div><label class="form-label" for="country">Country</label><input id="country" name="listing[country]" value="<%= listing.country %>" class="form-control" required></div></div><label class="form-label mt-3" for="category">Collection</label><select id="category" name="listing[category]" class="form-select" required><% ['Trending','Rooms','Cities','Mountain','Castles','Pools','Lakes','Beach','Camping','Domes','Arictic','Boats'].forEach(category => { %><option value="<%= category %>" <%= listing.category === category ? 'selected' : '' %>><%= category === 'Arictic' ? 'Arctic' : category %></option><% }) %></select></div></section>
    <section class="form-section"><div class="form-section-title"><span>03</span><div><h2>Price and image</h2><p>Your existing image stays unless you upload a replacement.</p></div></div><div class="form-section-fields"><label class="form-label" for="price">Nightly price (INR)</label><div class="money-input"><span>₹</span><input id="price" name="listing[price]" type="number" class="form-control" min="1" value="<%= listing.price %>" required></div><div class="current-image"><img src="<%= orignalImageUrl %>" alt="Current image for <%= listing.title %>"><div><strong>Current property image</strong><span>Upload below only if you want to replace it.</span></div></div><label class="upload-zone mt-4" for="image"><i class="fa-regular fa-image"></i><strong>Upload replacement image</strong><span>JPG, PNG or WEBP · optional</span><input id="image" name="listing[image]" type="file" accept="image/*" data-image-input></label><div class="image-preview" data-image-preview hidden><img alt="Replacement image preview"><button type="button" data-clear-image>Choose another</button></div></div></section>
    <div class="form-submit-bar"><a class="button button-ghost" href="/listings/<%= listing._id %>">Cancel</a><button class="button button-primary" type="submit">Save changes <i class="fa-solid fa-check"></i></button></div>
  </form>
</div></section>
