<% layout("/layouts/boilerplate") %>
<section class="page-hero"><div class="site-shell"><span class="eyebrow">Host workspace</span><h1>Your places, at a glance.</h1><p>Manage property details and follow real reservation activity from one focused dashboard.</p></div></section>
<section class="section host-dashboard"><div class="site-shell">
  <div class="stats-grid"><article><span>Total listings</span><strong><%= stats.totalListings %></strong><i class="fa-regular fa-building"></i></article><article><span>Paid reservations</span><strong><%= stats.totalBookings %></strong><i class="fa-regular fa-calendar-check"></i></article><article><span>Booked revenue</span><strong>₹<%= stats.revenue.toLocaleString('en-IN') %></strong><i class="fa-solid fa-indian-rupee-sign"></i></article></div>
  <div class="dashboard-title"><div><h2>Property portfolio</h2><p>Only listings owned by your account appear here.</p></div><a href="/listings/new" class="button button-primary"><i class="fa-solid fa-plus"></i> Add listing</a></div>
  <% if (listings.length) { %><div class="host-listing-list"><% listings.forEach(listing => { %><article><img src="<%= listing.image?.url %>" alt="<%= listing.title %>"><div class="host-listing-main"><span><%= listing.category === 'Arictic' ? 'Arctic' : listing.category %></span><h3><%= listing.title %></h3><p><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p></div><strong>₹<%= listing.price.toLocaleString('en-IN') %><small>/night</small></strong><div class="host-listing-actions"><a href="/listings/<%= listing._id %>" class="button button-ghost button-small">View</a><a href="/listings/<%= listing._id %>/edit" class="button button-dark button-small">Edit</a></div></article><% }) %></div><% } else { %><%- include("../includes/emptyState", { heading: "Your hosting story starts here", message: "Create your first listing and welcome travelers to a place you know well.", href: "/listings/new", cta: "Create a listing", icon: "fa-house-circle-check" }) %><% } %>
</div></section>
