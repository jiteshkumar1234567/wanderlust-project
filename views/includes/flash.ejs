<div class="toast-region" aria-live="polite" aria-atomic="true">
  <% if (typeof success !== "undefined" && success.length) { %>
    <% success.forEach(message => { %><div class="app-toast toast-success" data-app-toast><i class="fa-solid fa-circle-check"></i><span><%= message %></span><button type="button" data-dismiss-toast aria-label="Dismiss notification"><i class="fa-solid fa-xmark"></i></button></div><% }) %>
  <% } %>
  <% if (typeof error !== "undefined" && error.length) { %>
    <% error.forEach(message => { %><div class="app-toast toast-error" data-app-toast><i class="fa-solid fa-circle-exclamation"></i><span><%= message %></span><button type="button" data-dismiss-toast aria-label="Dismiss notification"><i class="fa-solid fa-xmark"></i></button></div><% }) %>
  <% } %>
</div>
